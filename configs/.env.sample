# Copy to `.env` in the repo root and adjust. `.env` is gitignored.
# Every variable is optional — the suite runs against the public DemoBlaze
# site with none of them set.

# Which environment configs/url.ts resolves: production (default) or staging.
ENV=production

# Override the URLs in configs/url.ts without editing code.
PRODUCTION_URL=https://www.demoblaze.com
PRODUCTION_API_URL=https://api.demoblaze.com
STAGING_URL=https://www.demoblaze.com
STAGING_API_URL=https://api.demoblaze.com

# 0 runs headed, useful when debugging locally. CI should leave this unset.
HEADLESS=1

# Browser window size for desktop projects. Defaults to 1920x1080 headless.
SCREEN_SIZE=1920x1080

# 1 attaches a screenshot to the report at every screenshotAndAttach() call.
CAPTURE=0

# Milliseconds to slow every action by — only for watching a flow by eye.
SLOW_MO=0

# Parallel workers (default 2). Each worker gets its own DemoBlaze account.
WORKERS=2

# Set by CI itself. Switches on retries and the GitHub reporter.
# CI=1

# Performance budgets (ms) — see configs/performance.ts.
PERF_DCL_BUDGET_MS=5000
PERF_LOAD_BUDGET_MS=10000
PERF_CONTENT_BUDGET_MS=8000
PERF_API_P95_BUDGET_MS=2000
PERF_API_SAMPLES=10
PERF_API_CONCURRENCY=5

# Only if the site under test sits behind HTTP Basic Auth.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
